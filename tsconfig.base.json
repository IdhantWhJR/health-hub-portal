{
  "compilerOptions": {
    "incremental": true,
    "isolatedModules": true,
    "lib": ["es2022"],

    "module": "esnext",
    "moduleResolution": "bundler",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "target": "es2022",

    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,

    "types": [],
    "customConditions": ["workspace"]
  }
}

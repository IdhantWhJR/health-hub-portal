# Copy this file to .env and fill in your values.
# Do NOT commit .env — it's already in .gitignore.

# ---- Option A: local Postgres (simplest for running on your own machine) ----
# Install Postgres 16 locally, create a database, then:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/healthhub

# ---- Option B: Supabase (if you want to keep using it) ----
# Use the "Session pooler" connection string from Supabase dashboard
# (Connect > Connection string > Session pooler tab), NOT the direct connection —
# the direct one is IPv6-only and many home/office networks are IPv4-only.
#
# IMPORTANT: any special characters in your password MUST be percent-encoded:
#   @  -> %40
#   :  -> %3A
#   /  -> %2F
#   #  -> %23
#   ?  -> %3F
# Easiest fix: just set a password with only letters and numbers, no symbols.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-<region>.pooler.supabase.com:5432/postgres

DATABASE_URL=
